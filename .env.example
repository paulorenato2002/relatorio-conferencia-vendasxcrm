# Leitura das boletas escaneadas via n8n.
# Copie este arquivo para `.env` e preencha. O `.env` não é versionado.
# A chave da OpenAI NÃO fica aqui: ela mora na credencial do n8n.

# URL de produção do webhook, copiada do node Webhook depois de ativar o
# workflow. Use a URL de "Production", não a de "Test" — a de teste só responde
# enquanto a aba do n8n está com o "Listen for test event" ligado.
N8N_BOLETAS_WEBHOOK_URL=https://SUA-INSTANCIA.app.n8n.cloud/webhook/boletas

# Token compartilhado. Precisa ser igual ao valor da credencial Header Auth
# ligada ao node Webhook.
N8N_BOLETAS_TOKEN=

# Nome do cabeçalho que leva o token. Mude apenas se tiver mudado também na
# credencial Header Auth do n8n.
N8N_BOLETAS_HEADER=X-Boletas-Token

# Segundos de espera por boleta. Leitura de manuscrito costuma levar de 10 a 30s.
N8N_BOLETAS_TIMEOUT=120

# Tentativas por boleta antes de desistir e registrar o aviso na tela.
N8N_BOLETAS_ATTEMPTS=3

# Boletas enviadas em paralelo. Suba com cuidado: cada uma é uma execução no
# n8n e uma chamada à OpenAI, e ambos têm limite de taxa.
N8N_BOLETAS_CONCURRENCY=4
